module Counter_8bit (
	input ena,
	input clk,
	input clear,
	output [7:0] count
); 
	wire ...
	
	TFlipFlop TFF_0 (
		.T(ena),
		.clk(clk),
		.clear(clear),
		.Qt(count[0])
	);
	
	TFlipFlop TFF_1 (
		.T(ena),
		.clk(clk),
		.clear(clear),
		.Qt(count[1])
	);
	
	TFlipFlop TFF_2 (
		.T(ena),
		.clk(clk),
		.clear(clear),
		.Qt(count[2])
	);
	
	TFlipFlop TFF_3 (
		.T(ena),
		.clk(clk),
		.clear(clear),
		.Qt(count[3])
	);
	
	TFlipFlop TFF_4 (
		.T(ena),
		.clk(clk),
		.clear(clear),
		.Qt(count[4])
	);
	
	TFlipFlop TFF_5 (
		.T(ena),
		.clk(clk),
		.clear(clear),
		.Qt(count[5])
	);
	
	TFlipFlop TFF_6 (
		.T(ena),
		.clk(clk),
		.clear(clear),
		.Qt(count[6])
	);
	
	TFlipFlop TFF_7 (
		.T(ena),
		.clk(clk),
		.clear(clear),
		.Qt(count[7])
	);

endmodule